set interface ip address eth0 10.240.167.1/16
set interface state eth0 up

create host-interface name veth-vpp
set interface ip address host-veth-vpp 10.0.0.1/24
set interface state host-veth-vpp up


classify table miss-next drop mask l3 ip4 src buckets 100000
set interface input acl intfc eth0 ip4-table 0
#ip session redirect table 0 match l3 ip4 src 10.240.165.1 via 10.0.0.2 host-veth-vpp
